# ─────────────────────────────────────────────
#  INTERVUEX — Backend Environment Variables
#  Copy this file to server/.env and fill in your values
# ─────────────────────────────────────────────

# Server
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

# PostgreSQL — local development
DB_HOST=localhost
DB_PORT=5432
DB_NAME=intervuex
DB_USER=postgres
DB_PASSWORD=your_postgres_password

# PostgreSQL — production (overrides above when set)
# DATABASE_URL=postgresql://user:password@host:5432/intervuex

# JWT — use a long random string in production
JWT_SECRET=change-this-to-a-long-random-secret

# OpenAI (required for AI question generation & evaluation)
OPENAI_API_KEY=sk-...

# Email — choose one service
# Option 1: Gmail (local dev only)
EMAIL_SERVICE=gmail
EMAIL_USER=your-gmail@gmail.com
EMAIL_PASSWORD=your-gmail-app-password
EMAIL_FROM="INTERVUEX <your-gmail@gmail.com>"

# Option 2: SendGrid (recommended for production)
# EMAIL_SERVICE=sendgrid
# SENDGRID_API_KEY=SG....
# EMAIL_FROM="INTERVUEX <noreply@yourdomain.com>"

# Option 3: Custom SMTP
# EMAIL_SERVICE=smtp
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-smtp-user
# SMTP_PASSWORD=your-smtp-password

# CORS — comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173

# File uploads
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads

# Session defaults
SESSION_DURATION=1800
LINK_EXPIRY_HOURS=24
